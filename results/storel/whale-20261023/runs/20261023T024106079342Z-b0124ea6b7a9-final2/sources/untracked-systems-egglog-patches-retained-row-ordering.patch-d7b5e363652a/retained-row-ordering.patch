+/// Preserve the existing minimum-row choice unless a multirow swap would
+/// retain more rows for later processing. Only consider vetoing a disconnected
+/// binary lookup: its two atoms have not participated in the executed prefix.
+/// Singleton filters, seminaive delta inputs, and already-bound residuals
+/// also keep priority. Their row bounds or bindings carry selectivity evidence
+/// that cached average group sizes cannot capture.
+/// Statistics only inspect indexes that already exist; missing statistics
+/// preserve the old minimum-row estimate.
+#[cfg(test)]
+pub(super) fn select_runtime_stage(
+    order: &InstrOrder,
+    range: Range<usize>,
+    instrs: &[JoinStage],
+    binding_info: &BindingInfo<'_, '_>,
+    prepared: Option<&PreparedJoinIndexes<'_>>,
+    remaining_stages: Option<u128>,
+) -> Option<usize> {
+    let winner = range.clone().min_by_key(|&position| {
+        let stage = &instrs[order.get(position)];
+        (
+            estimate_size(stage, binding_info),
+            -num_intersected_rels(stage),
+        )
+    })?;
+    if winner == range.start {
+        return Some(winner);
+    }
+    Some(guard_runtime_swap(
+        order,
+        range.start,
+        winner,
+        instrs,
+        binding_info,
+        prepared,
+        remaining_stages,
+    ))
+}
