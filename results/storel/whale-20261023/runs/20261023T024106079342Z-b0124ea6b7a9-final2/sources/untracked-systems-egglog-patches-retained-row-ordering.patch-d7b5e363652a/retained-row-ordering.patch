+/// Keep the normal row-minimum selector and no-swap return in the original
+/// sorting function. This relatively rare guard should not enlarge that hot
+/// loop or force it to carry the retained-cost calculation's temporaries.
+#[inline(never)]
+fn guard_runtime_swap(
+    order: &InstrOrder,
+    start: usize,
+    winner: usize,
+    instrs: &[JoinStage],
+    binding_info: &BindingInfo<'_, '_>,
+    prepared: Option<&PreparedJoinIndexes<'_>>,
+    remaining_stages: Option<u128>,
+) -> usize {
+    let winner_stage = &instrs[order.get(winner)];
+    // This guard models opening one new key domain and retaining the matching
+    // rows from one other input. Multiway intersections can use additional
+    // simultaneous predicates to reject a key or constrain several downstream
+    // branches before those rows are consumed. Preserve their existing DVO
+    // priority rather than interpreting a sum of group sizes as their cost.
+    let JoinStage::Intersect { scans, .. } = winner_stage else {
+        return winner;
+    };
+    if scans.len() != 2 || estimate_size(winner_stage, binding_info) <= 1 {
+        return winner;
+    }
+    // Restrict the estimate to opening a new, disconnected domain. Reusing
+    // an existing binding can reveal correlations even if its row bound did
+    // not shrink. This is a limit on where to trust average group sizes, not
+    // a preference for a stage with more bound variables.
+    let (Some(prepared), Some(_)) = (prepared, remaining_stages) else {
+        // Over-width plans have no mask; preserve the existing choice rather
+        // than scan or allocate a representation of their executed prefix.
+        return winner;
+    };
+    if scans.iter().any(|scan| {
+        prepared.seminaive_focus() == Some(scan.atom)
+            || !binding_info.subsets[scan.atom].is_plan_root()
+    }) {
+        return winner;
+    }
+    let cost = |position| {
+        retained_cost(
+            order.get(position),
+            instrs,
+            binding_info,
+            Some(prepared),
+            order,
+            start,
+            remaining_stages,
+        )
+    };
+    if cost(winner) <= cost(start) {
+        winner
+    } else {
+        start
+    }
+}
