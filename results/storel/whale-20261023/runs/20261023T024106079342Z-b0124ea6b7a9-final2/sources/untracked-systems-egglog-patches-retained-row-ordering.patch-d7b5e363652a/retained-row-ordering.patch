+/// Estimate key processing and the surplus retained rows that later stages
+/// may read: K * (1 + sum_live(rows_i / distinct_i - 1)).
+///
+/// Each matching key costs one unit. Unique inputs add no surplus; repeated
+/// rows add work only if another stage still consumes them. Cover scans count
+/// as consumers because even a factorized leaf must read its surviving rows
+/// once. Summing rather than multiplying respects factorized execution.
+pub(super) fn estimated_retained_work(
+    inputs: impl IntoIterator<Item = (usize, usize, bool)>,
+) -> f64 {
+    let mut keys = usize::MAX;
+    let mut work_per_key = 1.0f64;
+    for (rows, distinct, live) in inputs {
+        let distinct = distinct.min(rows);
+        if distinct == 0 {
+            return 0.0;
+        }
+        keys = keys.min(distinct);
+        if live {
+            work_per_key += rows as f64 / distinct as f64 - 1.0;
+        }
+    }
+    if keys == usize::MAX {
+        0.0
+    } else {
+        keys as f64 * work_per_key
+    }
+}
