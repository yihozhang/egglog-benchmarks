+        child_rc = self.proc.wait()
+        if child_rc == -9 and not killed_by_adapter:
+            report["status_hint"] = "oom"
+        report["engine_exit_code"] = child_rc
+        if child_rc < 0:
+            report["signal"] = -child_rc
+        return 124 if report.get("status_hint") == "timeout" else 1
