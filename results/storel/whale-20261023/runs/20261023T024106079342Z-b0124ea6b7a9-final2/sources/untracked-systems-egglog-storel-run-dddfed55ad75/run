#!/usr/bin/env python3
"""Run one benchmark program with one egglog-storel build.

Usage: run <build-dir> <program.egg> <fact-dir|-> <threads> <out-dir> [egglog flags...]

The program is run as is (the suite's programs are written for the extension's primitives);
everything is exactly systems/egglog/run, which this script execs: the build directory has
egglog's layout (egglog -> the extension binary, build.json), the CLI and the REPL protocol
are egglog's, and report.json has the same fields.
"""

import os
import sys
from pathlib import Path


def main() -> int:
    run = Path(__file__).resolve().parent.parent / "egglog" / "run"
    os.execv(str(run), [str(run), *sys.argv[1:]])


if __name__ == "__main__":
    sys.exit(main())
