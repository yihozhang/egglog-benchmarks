// egg port of the storel suite: STOREL's equality-saturation optimizer (SIGMOD'23, "Optimizing
// Tensor Programs on Flexible Storage"; an egg 0.6 program by Amir Shaikhha: sdql.rs,
// sdqlrules.rs, sdqlsubstitute.rs) ported to egg 0.11. This file is `include!`d by the
// per-kernel wrappers benchmarks/storel/egg/<kernel>.rs (generated by gen.py), which define
// KERNEL, START (the kernel's de Bruijn term) and NODE_LIMIT; nothing else is shared.
//
// Preserved exactly: the SDQL language with de Bruijn indices (%0, %1, ...), the e-class
// analysis (free-variable set, union over the class; `beta_extract`, the smallest term of the
// class, ties keep the existing one; `kind`), the shifting/beta-reduction appliers, the closure
// conditions and the fine-grained rule set `rules()` (44 rules, original order). Dropped: the
// cost function and extraction (not benchmarked), the named<->nameless conversion and the
// memory hook. egg 0.6 -> 0.11: `merge` returns `DidMerge(to_changed, from_differs)` computed
// honestly (0.6 re-analyzed `from`'s parents unconditionally); `make` takes `&mut EGraph`; an
// applier unions its result with the matched e-class itself (0.6's `apply_matches` did it) and
// reports nothing when the union was a no-op; `Shifted` forwards the rule name and passes no
// searcher ast to the inner applier (explanations are disabled).
//
// Runner: STOREL's configuration, `BackoffScheduler::default()` (match limit 1000, ban length
// 5), no iteration or time limit. NODE_LIMIT = Some(n) stops the run after the first iteration
// that ends with >= n e-nodes, like the egglog port's `;; BENCHMARK_NODE_LIMIT`; it is a runner
// hook rather than egg's own node limit, which counts hashcons entries including stale ones
// (~30% more than e-nodes here) and cuts the iteration short in the middle of the apply phase.
//
// Usage: <kernel> [--report FILE] [--scheduler backoff|simple]
// Prints e-nodes per constructor (the egglog port's names, (print-size) format) on stdout,
// a summary line on stderr and run time, iterations, stop reason and sizes as JSON.

use egg::{rewrite as rw, *};
use std::collections::HashSet;
use std::time::{Duration, Instant};

/// A de Bruijn index, written `%i`.
#[derive(Debug, PartialEq, Eq, PartialOrd, Ord, Clone, Hash, Copy)]
pub struct Index(pub u32);

impl std::str::FromStr for Index {
    type Err = Option<std::num::ParseIntError>;

    fn from_str(s: &str) -> Result<Self, Self::Err> {
        match s.strip_prefix('%') {
            Some(i) => i.parse().map(Index).map_err(Some),
            None => Err(None),
        }
    }
}

impl std::fmt::Display for Index {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        write!(f, "%{}", self.0)
    }
}

// The SDQL language. Binders: `lambda` binds %0 in its body; `let e body` binds %0 in body;
// `sum R body` binds the key (%1) and value (%0) in body; `merge R1 R2 body` binds k1 (%2),
// v1 (%1), k2 (%0) in body (STOREL reorders the original `merge k1 k2 v1` to k1 v1 k2).
define_language! {
    pub enum SDQL {
        Var(Index),
        Num(i32),
        "*" = Mul([Id; 2]),
        "+" = Add([Id; 2]),
        "-" = Sub([Id; 2]),
        "==" = Equality([Id; 2]),
        "let" = Let([Id; 2]),
        "sing" = Sing([Id; 2]),
        "ifthen" = IfThen([Id; 2]),
        "get" = Get([Id; 2]),
        "sum" = Sum([Id; 2]),
        "merge" = Merge([Id; 3]),
        "range" = Range([Id; 2]),
        "subarray" = SubArray([Id; 3]),
        "apply" = App([Id; 2]),
        "binop" = Binop([Id; 3]),
        "lambda" = Lambda(Id),
        "unique" = Unique(Id),
        Symbol(Symbol),
    }
}

pub type EGraph = egg::EGraph<SDQL, SDQLAnalysis>;
pub type SDQLRecExpr = RecExpr<SDQL>;

#[derive(Debug, PartialEq, Eq, PartialOrd, Ord, Clone, Hash, Copy)]
pub enum SDQLType {
    Vector,
    Dict,
    Scalar,
    Bool,
}

#[derive(Default, Debug)]
pub struct SDQLData {
    pub free: HashSet<Index>,
    pub beta_extract: SDQLRecExpr,
    pub kind: HashSet<SDQLType>,
}

#[derive(Default)]
pub struct SDQLAnalysis;

impl Analysis<SDQL> for SDQLAnalysis {
    type Data = SDQLData;

    fn merge(&mut self, to: &mut SDQLData, from: SDQLData) -> DidMerge {
        // free variables and kinds: set union
        let from_lacks_free = to.free.iter().any(|v| !from.free.contains(v));
        let free_before = to.free.len();
        to.free.extend(from.free);
        let to_free_changed = to.free.len() != free_before;

        let from_lacks_kind = to.kind.iter().any(|k| !from.kind.contains(k));
        let kind_before = to.kind.len();
        to.kind.extend(from.kind);
        let to_kind_changed = to.kind.len() != kind_before;

        // beta_extract: the strictly smaller term wins, ties keep `to`
        let (to_extract_changed, from_extract_differs) = if !from.beta_extract.as_ref().is_empty()
            && (to.beta_extract.as_ref().is_empty()
                || to.beta_extract.as_ref().len() > from.beta_extract.as_ref().len())
        {
            to.beta_extract = from.beta_extract;
            (true, false)
        } else {
            (false, to.beta_extract != from.beta_extract)
        };

        DidMerge(
            to_free_changed || to_kind_changed || to_extract_changed,
            from_lacks_free || from_lacks_kind || from_extract_differs,
        )
    }

    fn make(egraph: &mut EGraph, enode: &SDQL, _id: Id) -> SDQLData {
        let egraph: &EGraph = egraph;
        let mut free = HashSet::default();
        match enode {
            SDQL::Var(v) => {
                free.insert(*v);
            }
            SDQL::Lambda(_) => {
                enode.for_each(|c| {
                    free.extend(
                        egraph[c].data.free.iter().cloned()
                            .filter(|&idx| idx != Index(0))
                            .map(|idx| Index(idx.0 - 1)),
                    )
                });
            }
            SDQL::Let([e1, e2]) => {
                free.extend(egraph[*e1].data.free.iter().cloned());
                free.extend(
                    egraph[*e2].data.free.iter().cloned()
                        .filter(|&idx| idx != Index(0))
                        .map(|idx| Index(idx.0 - 1)),
                );
            }
            SDQL::Sum([e1, e2]) => {
                free.extend(egraph[*e1].data.free.iter().cloned());
                free.extend(
                    egraph[*e2].data.free.iter().cloned()
                        .filter(|&idx| idx.0 > 1)
                        .map(|idx| Index(idx.0 - 2)),
                );
            }
            SDQL::Merge([e1, e2, e3]) => {
                free.extend(egraph[*e1].data.free.iter().cloned());
                free.extend(egraph[*e2].data.free.iter().cloned());
                free.extend(
                    egraph[*e3].data.free.iter().cloned()
                        .filter(|&idx| idx.0 > 2)
                        .map(|idx| Index(idx.0 - 3)),
                );
            }
            _ => {
                enode.for_each(|c| free.extend(&egraph[c].data.free));
            }
        }
        let empty = enode.any(|id| egraph[id].data.beta_extract.as_ref().is_empty());
        let beta_extract = if empty {
            vec![].into()
        } else {
            enode.join_recexprs(|id| egraph[id].data.beta_extract.as_ref())
        };
        let mut kind = HashSet::default();
        match enode {
            SDQL::SubArray(_) | SDQL::Range(_) => {
                kind.insert(SDQLType::Vector);
            }
            SDQL::Equality(_) => {
                kind.insert(SDQLType::Bool);
            }
            SDQL::Num(_) => {
                kind.insert(SDQLType::Scalar);
            }
            SDQL::Sing(_) => {
                kind.insert(SDQLType::Dict);
            }
            _ => {}
        }
        SDQLData { free, beta_extract, kind }
    }
}

pub fn add(to: &mut Vec<SDQL>, e: SDQL) -> Id {
    to.push(e);
    Id::from(to.len() - 1)
}

pub fn add_expr(to: &mut Vec<SDQL>, e: &[SDQL]) -> Id {
    let offset = to.len();
    to.extend(e.iter().map(|n| n.clone().map_children(|id| Id::from(usize::from(id) + offset))));
    Id::from(to.len() - 1)
}

/*** shifting and substitution of de Bruijn indices (sdqlsubstitute.rs) ***/

pub fn shift_copy(expr: &SDQLRecExpr, up: bool, cutoff: Index, delta: Index) -> SDQLRecExpr {
    let mut result = expr.as_ref().to_owned();
    shift_mut(&mut result, up, cutoff, delta);
    result.into()
}

pub fn shift_mut(expr: &mut [SDQL], up: bool, cutoff: Index, delta: Index) {
    rec(expr, expr.len() - 1, up, cutoff, delta);

    fn rec(expr: &mut [SDQL], ei: usize, up: bool, cutoff: Index, delta: Index) {
        match expr[ei] {
            SDQL::Var(index) => {
                if index >= cutoff {
                    let index2 = Index(if up { index.0 + delta.0 } else { index.0 - delta.0 });
                    expr[ei] = SDQL::Var(index2);
                }
            }
            SDQL::Lambda(e) => {
                rec(expr, usize::from(e), up, Index(cutoff.0 + 1), delta);
            }
            SDQL::Let([e1, e2]) => {
                rec(expr, usize::from(e1), up, cutoff, delta);
                rec(expr, usize::from(e2), up, Index(cutoff.0 + 1), delta);
            }
            SDQL::Sum([e1, e2]) => {
                rec(expr, usize::from(e1), up, cutoff, delta);
                rec(expr, usize::from(e2), up, Index(cutoff.0 + 2), delta);
            }
            SDQL::Merge([e1, e2, e3]) => {
                rec(expr, usize::from(e1), up, cutoff, delta);
                rec(expr, usize::from(e2), up, cutoff, delta);
                rec(expr, usize::from(e3), up, Index(cutoff.0 + 3), delta);
            }
            SDQL::App([e1, e2])
            | SDQL::Add([e1, e2])
            | SDQL::Sub([e1, e2])
            | SDQL::Mul([e1, e2])
            | SDQL::Equality([e1, e2])
            | SDQL::IfThen([e1, e2])
            | SDQL::Get([e1, e2])
            | SDQL::Sing([e1, e2])
            | SDQL::Range([e1, e2]) => {
                rec(expr, usize::from(e1), up, cutoff, delta);
                rec(expr, usize::from(e2), up, cutoff, delta);
            }
            SDQL::Binop([e1, e2, e3]) | SDQL::SubArray([e1, e2, e3]) => {
                rec(expr, usize::from(e1), up, cutoff, delta);
                rec(expr, usize::from(e2), up, cutoff, delta);
                rec(expr, usize::from(e3), up, cutoff, delta);
            }
            SDQL::Unique(e1) => {
                rec(expr, usize::from(e1), up, cutoff, delta);
            }
            SDQL::Num(_) | SDQL::Symbol(_) => {}
        }
    }
}

/// `expr` with every occurrence of `index` (under binders: index + depth) replaced by `subs`,
/// which is shifted under binders as the traversal goes.
fn replace(expr: &[SDQL], index: Index, subs: &mut [SDQL]) -> Vec<SDQL> {
    let mut result = vec![];
    rec(&mut result, expr, expr.len() - 1, index, subs);

    fn rec(result: &mut Vec<SDQL>, expr: &[SDQL], ei: usize, index: Index, subs: &mut [SDQL]) -> Id {
        match expr[ei] {
            SDQL::Var(index2) => {
                if index == index2 {
                    add_expr(result, subs)
                } else {
                    add(result, SDQL::Var(index2))
                }
            }
            SDQL::Lambda(e) => {
                shift_mut(subs, true, Index(0), Index(1));
                let e2 = rec(result, expr, usize::from(e), Index(index.0 + 1), subs);
                shift_mut(subs, false, Index(0), Index(1));
                add(result, SDQL::Lambda(e2))
            }
            SDQL::Let([e1, e2]) => {
                let t1 = rec(result, expr, usize::from(e1), index, subs);
                shift_mut(subs, true, Index(0), Index(1));
                let t2 = rec(result, expr, usize::from(e2), Index(index.0 + 1), subs);
                shift_mut(subs, false, Index(0), Index(1));
                add(result, SDQL::Let([t1, t2]))
            }
            SDQL::Sum([e1, e2]) => {
                let t1 = rec(result, expr, usize::from(e1), index, subs);
                shift_mut(subs, true, Index(0), Index(2));
                let t2 = rec(result, expr, usize::from(e2), Index(index.0 + 2), subs);
                shift_mut(subs, false, Index(0), Index(2));
                add(result, SDQL::Sum([t1, t2]))
            }
            SDQL::Merge([e1, e2, e3]) => {
                let t1 = rec(result, expr, usize::from(e1), index, subs);
                let t2 = rec(result, expr, usize::from(e2), index, subs);
                shift_mut(subs, true, Index(0), Index(3));
                let t3 = rec(result, expr, usize::from(e3), Index(index.0 + 3), subs);
                shift_mut(subs, false, Index(0), Index(3));
                add(result, SDQL::Merge([t1, t2, t3]))
            }
            SDQL::App([f, e]) => {
                let f2 = rec(result, expr, usize::from(f), index, subs);
                let e2 = rec(result, expr, usize::from(e), index, subs);
                add(result, SDQL::App([f2, e2]))
            }
            SDQL::Binop([f, e1, e2]) => {
                let tf = rec(result, expr, usize::from(f), index, subs);
                let t1 = rec(result, expr, usize::from(e1), index, subs);
                let t2 = rec(result, expr, usize::from(e2), index, subs);
                add(result, SDQL::Binop([tf, t1, t2]))
            }
            SDQL::Add([e1, e2]) => {
                let t1 = rec(result, expr, usize::from(e1), index, subs);
                let t2 = rec(result, expr, usize::from(e2), index, subs);
                add(result, SDQL::Add([t1, t2]))
            }
            SDQL::Sub([e1, e2]) => {
                let t1 = rec(result, expr, usize::from(e1), index, subs);
                let t2 = rec(result, expr, usize::from(e2), index, subs);
                add(result, SDQL::Sub([t1, t2]))
            }
            SDQL::Mul([e1, e2]) => {
                let t1 = rec(result, expr, usize::from(e1), index, subs);
                let t2 = rec(result, expr, usize::from(e2), index, subs);
                add(result, SDQL::Mul([t1, t2]))
            }
            SDQL::Equality([e1, e2]) => {
                let t1 = rec(result, expr, usize::from(e1), index, subs);
                let t2 = rec(result, expr, usize::from(e2), index, subs);
                add(result, SDQL::Equality([t1, t2]))
            }
            SDQL::IfThen([e1, e2]) => {
                let t1 = rec(result, expr, usize::from(e1), index, subs);
                let t2 = rec(result, expr, usize::from(e2), index, subs);
                add(result, SDQL::IfThen([t1, t2]))
            }
            SDQL::Get([e1, e2]) => {
                let t1 = rec(result, expr, usize::from(e1), index, subs);
                let t2 = rec(result, expr, usize::from(e2), index, subs);
                add(result, SDQL::Get([t1, t2]))
            }
            SDQL::Sing([e1, e2]) => {
                let t1 = rec(result, expr, usize::from(e1), index, subs);
                let t2 = rec(result, expr, usize::from(e2), index, subs);
                add(result, SDQL::Sing([t1, t2]))
            }
            SDQL::Range([e1, e2]) => {
                let t1 = rec(result, expr, usize::from(e1), index, subs);
                let t2 = rec(result, expr, usize::from(e2), index, subs);
                add(result, SDQL::Range([t1, t2]))
            }
            SDQL::SubArray([e1, e2, e3]) => {
                let t1 = rec(result, expr, usize::from(e1), index, subs);
                let t2 = rec(result, expr, usize::from(e2), index, subs);
                let t3 = rec(result, expr, usize::from(e3), index, subs);
                add(result, SDQL::SubArray([t1, t2, t3]))
            }
            SDQL::Unique(e1) => {
                let t1 = rec(result, expr, usize::from(e1), index, subs);
                add(result, SDQL::Unique(t1))
            }
            SDQL::Symbol(_) | SDQL::Num(_) => add(result, expr[ei].clone()),
        }
    }

    result
}

/// `(let arg body)` reduced: `body[%0 := arg]` with the remaining indices shifted down.
pub fn beta_reduce(body: &SDQLRecExpr, arg: &SDQLRecExpr) -> SDQLRecExpr {
    let arg2 = &mut arg.as_ref().to_owned();

    shift_mut(arg2, true, Index(0), Index(1));
    let mut body2 = replace(body.as_ref(), Index(0), arg2);
    shift_mut(&mut body2, false, Index(0), Index(1));
    body2.into()
}

/// Beta-reduces the smallest known terms (`beta_extract`) of the bound classes.
pub struct BetaExtractApplier {
    pub body: Var,
    pub subs: Var,
}

impl Applier<SDQL, SDQLAnalysis> for BetaExtractApplier {
    fn apply_one(
        &self,
        egraph: &mut EGraph,
        eclass: Id,
        subst: &Subst,
        _searcher_ast: Option<&PatternAst<SDQL>>,
        _rule_name: Symbol,
    ) -> Vec<Id> {
        let ex_body = &egraph[subst[self.body]].data.beta_extract;
        let ex_subs = &egraph[subst[self.subs]].data.beta_extract;
        let result = beta_reduce(ex_body, ex_subs);
        let id = egraph.add_expr(&result);
        if egraph.union(id, eclass) {
            vec![id]
        } else {
            vec![]
        }
    }
}

pub fn with_shifted_up<A>(var: Var, new_var: Var, cutoff: u32, applier: A) -> Shifted<A>
where
    A: Applier<SDQL, SDQLAnalysis>,
{
    with_delta_shifted_up(var, new_var, cutoff, 1, applier)
}

pub fn with_shifted_double_up<A>(var: Var, new_var: Var, cutoff: u32, applier: A) -> Shifted<A>
where
    A: Applier<SDQL, SDQLAnalysis>,
{
    with_delta_shifted_up(var, new_var, cutoff, 2, applier)
}

pub fn with_delta_shifted_up<A>(var: Var, new_var: Var, cutoff: u32, delta: u32, applier: A) -> Shifted<A>
where
    A: Applier<SDQL, SDQLAnalysis>,
{
    Shifted { var, new_var, up: true, cutoff: Index(cutoff), delta: Index(delta), applier }
}

pub fn with_shifted_double_down<A>(var: Var, new_var: Var, cutoff: u32, applier: A) -> Shifted<A>
where
    A: Applier<SDQL, SDQLAnalysis>,
{
    with_delta_shifted_down(var, new_var, cutoff, 2, applier)
}

pub fn with_delta_shifted_down<A>(var: Var, new_var: Var, cutoff: u32, delta: u32, applier: A) -> Shifted<A>
where
    A: Applier<SDQL, SDQLAnalysis>,
{
    Shifted { var, new_var, up: false, cutoff: Index(cutoff), delta: Index(delta), applier }
}

/// Binds `new_var` to the smallest known term of `var` with its free indices >= cutoff shifted
/// by delta, then runs the inner applier.
pub struct Shifted<A> {
    var: Var,
    new_var: Var,
    up: bool,
    cutoff: Index,
    delta: Index,
    applier: A,
}

impl<A> Applier<SDQL, SDQLAnalysis> for Shifted<A>
where
    A: Applier<SDQL, SDQLAnalysis>,
{
    fn apply_one(
        &self,
        egraph: &mut EGraph,
        eclass: Id,
        subst: &Subst,
        _searcher_ast: Option<&PatternAst<SDQL>>,
        rule_name: Symbol,
    ) -> Vec<Id> {
        let extract = &egraph[subst[self.var]].data.beta_extract;
        let shifted = shift_copy(extract, self.up, self.cutoff, self.delta);
        let mut subst = subst.clone();
        subst.insert(self.new_var, egraph.add_expr(&shifted));
        self.applier.apply_one(egraph, eclass, &subst, None, rule_name)
    }
}

/*** the rules (sdqlrules.rs, the fine-grained set `rules()`) ***/

fn var(s: &str) -> Var {
    s.parse().unwrap()
}

fn contains_ident(v1: Var, index: Index) -> impl Fn(&mut EGraph, Id, &Subst) -> bool {
    move |egraph, _, subst| egraph[subst[v1]].data.free.contains(&index)
}

fn neg(f: impl Fn(&mut EGraph, Id, &Subst) -> bool) -> impl Fn(&mut EGraph, Id, &Subst) -> bool {
    move |egraph, id, subst| !f(egraph, id, subst)
}

fn and(
    f1: impl Fn(&mut EGraph, Id, &Subst) -> bool,
    f2: impl Fn(&mut EGraph, Id, &Subst) -> bool,
) -> impl Fn(&mut EGraph, Id, &Subst) -> bool {
    move |egraph, id, subst| f1(egraph, id, subst) && f2(egraph, id, subst)
}

fn pat(s: &str) -> Pattern<SDQL> {
    s.parse().unwrap()
}

#[rustfmt::skip]
pub fn rules() -> Vec<Rewrite<SDQL, SDQLAnalysis>> {
    vec![
        /*** algebraic rules ***/
        rw!("mult-assoc1"; "(* (* ?a ?b) ?c)" => "(* ?a (* ?b ?c))"),
        rw!("mult-assoc2"; "(* ?a (* ?b ?c))" => "(* (* ?a ?b) ?c)"),
        rw!("sub-identity";"(- ?e ?e)"        => "0"),
        rw!("add-zero";    "(+ ?e 0)"         => "?e"),
        rw!("sub-zero";    "(- ?e 0)"         => "?e"),
        rw!("eq-comm"; "(== ?a ?b)" => "(== ?b ?a)"),
        /*** normalize constructs to unary and binary operators ***/
        rw!("mult-app1"; "(* ?a ?b)" => "(binop mult ?a ?b)"),
        rw!("mult-app2"; "(binop mult ?a ?b)" => "(* ?a ?b)"),
        rw!("add-app1"; "(+ ?a ?b)" => "(binop add ?a ?b)"),
        rw!("add-app2"; "(binop add ?a ?b)" => "(+ ?a ?b)"),
        rw!("sub-app1"; "(- ?a ?b)" => "(binop sub ?a ?b)"),
        rw!("sub-app2"; "(binop sub ?a ?b)" => "(- ?a ?b)"),
        rw!("get-app1"; "(get ?a ?b)" => "(binop getf ?a ?b)"),
        rw!("get-app2"; "(binop getf ?a ?b)" => "(get ?a ?b)"),
        rw!("sing-app1"; "(sing ?a ?b)" => "(binop singf ?a ?b)"),
        rw!("sing-app2"; "(binop singf ?a ?b)" => "(sing ?a ?b)"),
        rw!("unique-app1"; "(unique ?a)" => "(apply uniquef ?a)"),
        rw!("unique-app2"; "(apply uniquef ?a)" => "(unique ?a)"),
        /*** let-floating for binary and unary operators ***/
        rw!("let-binop3"; "(let ?e1 (binop ?f ?e2 ?e3))" => "(binop ?f (let ?e1 ?e2) (let ?e1 ?e3))"),
        rw!("let-binop4"; "(binop ?f (let ?e1 ?e2) (let ?e1 ?e3))" => "(let ?e1 (binop ?f ?e2 ?e3))"),
        rw!("let-apply1"; "(let ?e1 (apply ?e2 ?e3))" => "(apply ?e2 (let ?e1 ?e3))"),
        rw!("let-apply2"; "(apply ?e2 (let ?e1 ?e3))" => "(let ?e1 (apply ?e2 ?e3))"),
        /*** if-then-else ***/
        rw!("if-mult2"; "(* ?e1 (ifthen ?e2 ?e3))" => "(ifthen ?e2 (* ?e1 ?e3))"),
        /*** if-then-else normalization ***/
        rw!("if-to-mult"; "(ifthen ?e1 ?e2)" => "(* ?e1 ?e2)"),
        rw!("mult-to-if"; "(* (== ?e1_1 ?e1_2) ?e2)" => "(ifthen (== ?e1_1 ?e1_2) ?e2)"),
        /*** beta-reduction ***/
        rw!("beta"; "(let ?e ?body)" =>
            { BetaExtractApplier { body: var("?body"), subs: var("?e") } }),
        /*** sum-factorization ***/
        rw!("sum-fact-1";  "(sum ?R (* ?e1 ?e2))"        =>
            { with_shifted_double_down(var("?e1"), var("?e1d"), 2, pat("(* ?e1d (sum ?R ?e2))")) }
            if and(neg(contains_ident(var("?e1"), Index(0))), neg(contains_ident(var("?e1"), Index(1))))),
        rw!("sum-fact-2";  "(sum ?R (* ?e1 ?e2))"        =>
            { with_shifted_double_down(var("?e2"), var("?e2d"), 2, pat("(* (sum ?R ?e1) ?e2d)")) }
            if and(neg(contains_ident(var("?e2"), Index(0))), neg(contains_ident(var("?e2"), Index(1))))),
        rw!("sum-fact-3";  "(sum ?R (sing ?e1 ?e2))"        =>
            { with_shifted_double_down(var("?e1"), var("?e1d"), 2, pat("(sing ?e1d (sum ?R ?e2))")) }
            if and(neg(contains_ident(var("?e1"), Index(0))), neg(contains_ident(var("?e1"), Index(1))))),
        /*** sing-mult associativity ***/
        rw!("sing-mult-1"; "(sing ?e1 (* ?e2 ?e3))" => "(* (sing ?e1 ?e2) ?e3)"),
        rw!("sing-mult-2"; "(sing ?e1 (* ?e2 ?e3))" => "(* ?e2 (sing ?e1 ?e3))"),
        rw!("sing-mult-3"; "(* (sing ?e1 ?e2) ?e3)" => "(sing ?e1 (* ?e2 ?e3))"),
        rw!("sing-mult-4"; "(* ?e2 (sing ?e1 ?e3))" => "(sing ?e1 (* ?e2 ?e3))"),
        /*** sum-defactorization ***/
        rw!("sum-fact-inv-1";  "(* ?e1 (sum ?R ?e2))"        =>
            { with_shifted_double_up(var("?e1"), var("?e1u"), 0,
                pat("(sum ?R (* ?e1u ?e2))")
            )}),
        rw!("sum-fact-inv-3";  "(sing ?e1 (sum ?R ?e2))"        =>
            { with_shifted_double_up(var("?e1"), var("?e1u"), 0,
                pat("(sum ?R (sing ?e1u ?e2))")
            )}),
        /*** sum-sum vertical fusion ***/
        rw!("sum-sum-vert-fuse-1";  "(sum (sum ?R (sing %1 ?body1)) ?body2)"        =>
            { with_shifted_up(var("?body1"), var("?body1u"), 0,
              with_shifted_double_up(var("?body2"), var("?body2u"), 2,
                pat("(sum ?R (let %1 (let ?body1u ?body2u)))")
            ))}),
        rw!("sum-sum-vert-fuse-2";  "(sum (sum ?R (sing (unique ?key) ?body1)) ?body2)"        =>
            { with_shifted_up(var("?body1"), var("?body1u"), 0,
              with_shifted_double_up(var("?body2"), var("?body2u"), 2,
                pat("(sum ?R (let (unique ?key) (let ?body1u ?body2u)))")
            ))}),
        /*** sum-range vertical fusion ***/
        rw!("sum-range-1";  "(sum (range ?st ?en) (ifthen (== %0 ?key) ?body))" =>
              { with_shifted_double_up(var("?st"), var("?stu"), 0,
                pat("(sum (range ?st ?en) (ifthen (== %1 (- ?key (- ?stu 1))) ?body))")
            )}),
        /*** nested sum to merge conversion ***/
        rw!("sum-merge";  "(sum ?R (sum ?S (ifthen (== %2 %0) ?body)))"        =>
            { with_shifted_double_down(var("?S"), var("?Sd"), 2,
                pat("(merge ?R ?Sd (let %1 ?body))")
            )}),
        /*** get and sum conversion ***/
        rw!("get-to-sum";  "(get ?dict ?key)"        =>
            { with_shifted_double_up(var("?key"), var("?keyu"), 0,
                pat("(sum ?dict (ifthen (== %1 ?keyu) %0))")
            )}),
        rw!("sum-to-get";  "(sum ?R (ifthen (== %1 ?body2) ?body1))" =>
            { with_shifted_up(var("?R"), var("?Ru"), 0,
              with_shifted_double_down(var("?body2"), var("?body2d"), 2,
                pat("(let ?body2d (let (get ?Ru %0) ?body1))")
            ))} if and(neg(contains_ident(var("?body2"), Index(0))), neg(contains_ident(var("?body2"), Index(1))))),
        rw!("get-range";  "(get (range ?st ?en) ?idx)"        =>
            "(+ ?idx (- ?st 1))"),
        /*** sum simplifier  ***/
        rw!("sum-sing";    "(sum ?e1 (sing %1 %0))" => "?e1"),
        /*** annotation removal ***/
        rw!("unique-rm";   "(unique ?e)" => "?e"),
    ]
}

/*** driver ***/

fn main() {
    let mut report = None;
    let mut simple = false; // --scheduler simple: egg's SimpleScheduler instead of STOREL's BackoffScheduler
    let mut args = std::env::args().skip(1);
    while let Some(a) = args.next() {
        match a.as_str() {
            "--report" => report = Some(args.next().expect("--report FILE")),
            "--scheduler" => match args.next().as_deref() {
                Some("backoff") => simple = false,
                Some("simple") => simple = true,
                other => panic!("--scheduler backoff|simple, got {other:?}"),
            },
            _ => panic!("unknown argument {a}"),
        }
    }

    let rules = rules();
    let start: SDQLRecExpr = START.parse().unwrap();

    let t0 = Instant::now();
    let mut runner: Runner<SDQL, SDQLAnalysis> = Runner::default()
        .with_explanations_disabled()
        .with_iter_limit(usize::MAX)
        .with_node_limit(usize::MAX)
        .with_time_limit(Duration::from_secs(u64::MAX / 4));
    // STOREL's configuration is egg's default BackoffScheduler (match limit 1000, ban length 5)
    runner = if simple { runner.with_scheduler(SimpleScheduler) } else { runner.with_scheduler(BackoffScheduler::default()) };
    if let Some(n) = NODE_LIMIT {
        // hooks run at the start of an iteration, i.e. after the previous one's rebuild
        runner = runner.with_hook(move |r| {
            if r.egraph.total_number_of_nodes() >= n { Err("node-limit".into()) } else { Ok(()) }
        });
    }
    let runner = runner.with_expr(&start).run(&rules);
    let run_s = t0.elapsed().as_secs_f64();

    let stop_reason = match runner.stop_reason.as_ref().unwrap() {
        StopReason::Saturated => "saturated",
        StopReason::NodeLimit(_) => "node-limit",
        StopReason::Other(s) if s == "node-limit" => "node-limit",
        StopReason::IterationLimit(_) => "iteration-limit",
        StopReason::TimeLimit(_) => "time-limit",
        StopReason::Other(_) => "other",
    };
    // a hook stop happens in an extra iteration that searches and applies nothing: do not count it
    let iterations = runner.iterations.len()
        - matches!(runner.stop_reason, Some(StopReason::Other(_))) as usize;
    let empty_iterations = runner.iterations.iter().filter(|i| i.applied.is_empty()).count();
    let nodes = runner.egraph.total_number_of_nodes();
    let classes = runner.egraph.number_of_classes();

    let mut sizes = std::collections::BTreeMap::<&str, usize>::new();
    for class in runner.egraph.classes() {
        for node in &class.nodes {
            let name = match node {
                SDQL::Var(_) => "Var", SDQL::Num(_) => "Num", SDQL::Symbol(_) => "Sym",
                SDQL::Mul(_) => "Mul", SDQL::Add(_) => "Add", SDQL::Sub(_) => "Sub",
                SDQL::Equality(_) => "Eq", SDQL::Let(_) => "Let", SDQL::Sing(_) => "Sing",
                SDQL::IfThen(_) => "IfThen", SDQL::Get(_) => "Get", SDQL::Sum(_) => "Sum",
                SDQL::Merge(_) => "Merge", SDQL::Range(_) => "Range", SDQL::SubArray(_) => "SubArray",
                SDQL::App(_) => "App", SDQL::Binop(_) => "Binop", SDQL::Lambda(_) => "Lambda",
                SDQL::Unique(_) => "Unique",
            };
            *sizes.entry(name).or_default() += 1;
        }
    }
    println!("(");
    for (name, n) in &sizes {
        println!(" ({name} {n})");
    }
    println!(")");
    eprintln!(
        "egg: storel/{KERNEL}: {iterations} iterations, {nodes} e-nodes, {classes} e-classes, stop reason {stop_reason}, {run_s:.3}s"
    );

    if let Some(path) = report {
        let search: f64 = runner.iterations.iter().map(|i| i.search_time).sum();
        let apply: f64 = runner.iterations.iter().map(|i| i.apply_time).sum();
        let rebuild: f64 = runner.iterations.iter().map(|i| i.rebuild_time).sum();
        std::fs::write(path, format!(
            "{{\"run_s\": {run_s}, \"search_apply_s\": {}, \"search_s\": {search}, \"apply_s\": {apply}, \"merge_s\": 0, \"rebuild_s\": {rebuild}, \"iterations\": {iterations}, \"empty_iterations\": {empty_iterations}, \"stop_reason\": \"{stop_reason}\", \"saturated\": {}, \"nodes\": {nodes}, \"classes\": {classes}}}",
            search + apply, stop_reason == "saturated"
        )).expect("write report");
    }
}
