;; STOREL kernel ttm-1st: generated by gen.py from inputs/ttm_1st.sexp; do not edit.
;; The smallest terms are values of the egglog-storel extension's Frozen base sort; beta reduction and
;; shifting are its fsubst/fshift primitives, thaw adds the result (systems/egglog-storel/crate).

(datatype Term
  (Var i64)
  (Num i64)
  (Sym String)
  (Mul Term Term)
  (Add Term Term)
  (Sub Term Term)
  (Eq Term Term)
  (Let Term Term)
  (Sing Term Term)
  (IfThen Term Term)
  (Get Term Term)
  (Sum Term Term)
  (Merge Term Term Term)
  (Range Term Term)
  (SubArray Term Term Term)
  (App Term Term)
  (Binop Term Term Term)
  (Lambda Term)
  (Unique Term))

(ruleset phase1)  ; STOREL's rules up to and including beta
(ruleset phase2)  ; the rules after beta
(ruleset aux)     ; the analysis

(function best (Term) Frozen :merge (frozen-min old new))  ; the smallest known term, by (size, HASH)
(function free (Term) i64 :merge (| old new))      ; free de Bruijn indices (bit set), union over the class

(rule ((= e (Var i))) ((set (best e) (fvar i)) (set (free e) (<< 1 i))) :ruleset aux)
(rule ((= e (Num n))) ((set (best e) (fnum n)) (set (free e) 0)) :ruleset aux)
(rule ((= e (Sym s))) ((set (best e) (fsym s)) (set (free e) 0)) :ruleset aux)
(rule ((= e (Mul c0 c1)) (= f0 (best c0)) (= f1 (best c1))) ((set (best e) (f2 "Mul" f0 f1))) :ruleset aux)
(rule ((= e (Mul c0 c1)) (= v0 (free c0)) (= v1 (free c1))) ((set (free e) (| v0 v1))) :ruleset aux)
(rule ((= e (Add c0 c1)) (= f0 (best c0)) (= f1 (best c1))) ((set (best e) (f2 "Add" f0 f1))) :ruleset aux)
(rule ((= e (Add c0 c1)) (= v0 (free c0)) (= v1 (free c1))) ((set (free e) (| v0 v1))) :ruleset aux)
(rule ((= e (Sub c0 c1)) (= f0 (best c0)) (= f1 (best c1))) ((set (best e) (f2 "Sub" f0 f1))) :ruleset aux)
(rule ((= e (Sub c0 c1)) (= v0 (free c0)) (= v1 (free c1))) ((set (free e) (| v0 v1))) :ruleset aux)
(rule ((= e (Eq c0 c1)) (= f0 (best c0)) (= f1 (best c1))) ((set (best e) (f2 "Eq" f0 f1))) :ruleset aux)
(rule ((= e (Eq c0 c1)) (= v0 (free c0)) (= v1 (free c1))) ((set (free e) (| v0 v1))) :ruleset aux)
(rule ((= e (Let c0 c1)) (= f0 (best c0)) (= f1 (best c1))) ((set (best e) (f2 "Let" f0 f1))) :ruleset aux)
(rule ((= e (Let c0 c1)) (= v0 (free c0)) (= v1 (free c1))) ((set (free e) (| v0 (>> v1 1)))) :ruleset aux)
(rule ((= e (Sing c0 c1)) (= f0 (best c0)) (= f1 (best c1))) ((set (best e) (f2 "Sing" f0 f1))) :ruleset aux)
(rule ((= e (Sing c0 c1)) (= v0 (free c0)) (= v1 (free c1))) ((set (free e) (| v0 v1))) :ruleset aux)
(rule ((= e (IfThen c0 c1)) (= f0 (best c0)) (= f1 (best c1))) ((set (best e) (f2 "IfThen" f0 f1))) :ruleset aux)
(rule ((= e (IfThen c0 c1)) (= v0 (free c0)) (= v1 (free c1))) ((set (free e) (| v0 v1))) :ruleset aux)
(rule ((= e (Get c0 c1)) (= f0 (best c0)) (= f1 (best c1))) ((set (best e) (f2 "Get" f0 f1))) :ruleset aux)
(rule ((= e (Get c0 c1)) (= v0 (free c0)) (= v1 (free c1))) ((set (free e) (| v0 v1))) :ruleset aux)
(rule ((= e (Sum c0 c1)) (= f0 (best c0)) (= f1 (best c1))) ((set (best e) (f2 "Sum" f0 f1))) :ruleset aux)
(rule ((= e (Sum c0 c1)) (= v0 (free c0)) (= v1 (free c1))) ((set (free e) (| v0 (>> v1 2)))) :ruleset aux)
(rule ((= e (Merge c0 c1 c2)) (= f0 (best c0)) (= f1 (best c1)) (= f2 (best c2))) ((set (best e) (f3 "Merge" f0 f1 f2))) :ruleset aux)
(rule ((= e (Merge c0 c1 c2)) (= v0 (free c0)) (= v1 (free c1)) (= v2 (free c2))) ((set (free e) (| (| v0 v1) (>> v2 3)))) :ruleset aux)
(rule ((= e (Range c0 c1)) (= f0 (best c0)) (= f1 (best c1))) ((set (best e) (f2 "Range" f0 f1))) :ruleset aux)
(rule ((= e (Range c0 c1)) (= v0 (free c0)) (= v1 (free c1))) ((set (free e) (| v0 v1))) :ruleset aux)
(rule ((= e (SubArray c0 c1 c2)) (= f0 (best c0)) (= f1 (best c1)) (= f2 (best c2))) ((set (best e) (f3 "SubArray" f0 f1 f2))) :ruleset aux)
(rule ((= e (SubArray c0 c1 c2)) (= v0 (free c0)) (= v1 (free c1)) (= v2 (free c2))) ((set (free e) (| (| v0 v1) v2))) :ruleset aux)
(rule ((= e (App c0 c1)) (= f0 (best c0)) (= f1 (best c1))) ((set (best e) (f2 "App" f0 f1))) :ruleset aux)
(rule ((= e (App c0 c1)) (= v0 (free c0)) (= v1 (free c1))) ((set (free e) (| v0 v1))) :ruleset aux)
(rule ((= e (Binop c0 c1 c2)) (= f0 (best c0)) (= f1 (best c1)) (= f2 (best c2))) ((set (best e) (f3 "Binop" f0 f1 f2))) :ruleset aux)
(rule ((= e (Binop c0 c1 c2)) (= v0 (free c0)) (= v1 (free c1)) (= v2 (free c2))) ((set (free e) (| (| v0 v1) v2))) :ruleset aux)
(rule ((= e (Lambda c0)) (= f0 (best c0))) ((set (best e) (f1 "Lambda" f0))) :ruleset aux)
(rule ((= e (Lambda c0)) (= v0 (free c0))) ((set (free e) (>> v0 1))) :ruleset aux)
(rule ((= e (Unique c0)) (= f0 (best c0))) ((set (best e) (f1 "Unique" f0))) :ruleset aux)
(rule ((= e (Unique c0)) (= v0 (free c0))) ((set (free e) v0)) :ruleset aux)

(rewrite (Mul (Mul a b) c) (Mul a (Mul b c)) :ruleset phase1)  ; mult-assoc1
(rewrite (Mul a (Mul b c)) (Mul (Mul a b) c) :ruleset phase1)  ; mult-assoc2
(rewrite (Sub e e) (Num 0) :ruleset phase1)  ; sub-identity
(rewrite (Add e (Num 0)) e :ruleset phase1)  ; add-zero
(rewrite (Sub e (Num 0)) e :ruleset phase1)  ; sub-zero
(rewrite (Eq a b) (Eq b a) :ruleset phase1)  ; eq-comm
(rewrite (Mul a b) (Binop (Sym "mult") a b) :ruleset phase1)  ; mult-app1
(rewrite (Binop (Sym "mult") a b) (Mul a b) :ruleset phase1)  ; mult-app2
(rewrite (Add a b) (Binop (Sym "add") a b) :ruleset phase1)  ; add-app1
(rewrite (Binop (Sym "add") a b) (Add a b) :ruleset phase1)  ; add-app2
(rewrite (Sub a b) (Binop (Sym "sub") a b) :ruleset phase1)  ; sub-app1
(rewrite (Binop (Sym "sub") a b) (Sub a b) :ruleset phase1)  ; sub-app2
(rewrite (Get a b) (Binop (Sym "getf") a b) :ruleset phase1)  ; get-app1
(rewrite (Binop (Sym "getf") a b) (Get a b) :ruleset phase1)  ; get-app2
(rewrite (Sing a b) (Binop (Sym "singf") a b) :ruleset phase1)  ; sing-app1
(rewrite (Binop (Sym "singf") a b) (Sing a b) :ruleset phase1)  ; sing-app2
(rewrite (Unique a) (App (Sym "uniquef") a) :ruleset phase1)  ; unique-app1
(rewrite (App (Sym "uniquef") a) (Unique a) :ruleset phase1)  ; unique-app2
(rewrite (Let e1 (Binop f e2 e3)) (Binop f (Let e1 e2) (Let e1 e3)) :ruleset phase1)  ; let-binop3
(rewrite (Binop f (Let e1 e2) (Let e1 e3)) (Let e1 (Binop f e2 e3)) :ruleset phase1)  ; let-binop4
(rewrite (Let e1 (App e2 e3)) (App e2 (Let e1 e3)) :ruleset phase1)  ; let-apply1
(rewrite (App e2 (Let e1 e3)) (Let e1 (App e2 e3)) :ruleset phase1)  ; let-apply2
(rewrite (Mul e1 (IfThen e2 e3)) (IfThen e2 (Mul e1 e3)) :ruleset phase1)  ; if-mult2
(rewrite (IfThen e1 e2) (Mul e1 e2) :ruleset phase1)  ; if-to-mult
(rewrite (Mul (Eq e1_1 e1_2) e2) (IfThen (Eq e1_1 e1_2) e2) :ruleset phase1)  ; mult-to-if
(rule ((= lhs (Let e body))  (= f_e (best e)) (= f_body (best body)))
      ((union lhs (thaw (fsubst 0 f_e f_body)))) :ruleset phase1 :unsafe-seminaive)  ; beta
(rule ((= lhs (Sum R (Mul e1 e2))) (= fv_e1 (free e1)) (= (& fv_e1 3) 0) (= f_e1 (best e1)))
      ((union lhs (Mul (thaw (fshift 2 -2 f_e1)) (Sum R e2)))) :ruleset phase2 :unsafe-seminaive)  ; sum-fact-1
(rule ((= lhs (Sum R (Mul e1 e2))) (= fv_e2 (free e2)) (= (& fv_e2 3) 0) (= f_e2 (best e2)))
      ((union lhs (Mul (Sum R e1) (thaw (fshift 2 -2 f_e2))))) :ruleset phase2 :unsafe-seminaive)  ; sum-fact-2
(rule ((= lhs (Sum R (Sing e1 e2))) (= fv_e1 (free e1)) (= (& fv_e1 3) 0) (= f_e1 (best e1)))
      ((union lhs (Sing (thaw (fshift 2 -2 f_e1)) (Sum R e2)))) :ruleset phase2 :unsafe-seminaive)  ; sum-fact-3
(rewrite (Sing e1 (Mul e2 e3)) (Mul (Sing e1 e2) e3) :ruleset phase2)  ; sing-mult-1
(rewrite (Sing e1 (Mul e2 e3)) (Mul e2 (Sing e1 e3)) :ruleset phase2)  ; sing-mult-2
(rewrite (Mul (Sing e1 e2) e3) (Sing e1 (Mul e2 e3)) :ruleset phase2)  ; sing-mult-3
(rewrite (Mul e2 (Sing e1 e3)) (Sing e1 (Mul e2 e3)) :ruleset phase2)  ; sing-mult-4
(rule ((= lhs (Mul e1 (Sum R e2)))  (= f_e1 (best e1)))
      ((union lhs (Sum R (Mul (thaw (fshift 0 2 f_e1)) e2)))) :ruleset phase2 :unsafe-seminaive)  ; sum-fact-inv-1
(rule ((= lhs (Sing e1 (Sum R e2)))  (= f_e1 (best e1)))
      ((union lhs (Sum R (Sing (thaw (fshift 0 2 f_e1)) e2)))) :ruleset phase2 :unsafe-seminaive)  ; sum-fact-inv-3
(rule ((= lhs (Sum (Sum R (Sing (Var 1) body1)) body2))  (= f_body1 (best body1)) (= f_body2 (best body2)))
      ((union lhs (Sum R (Let (Var 1) (Let (thaw (fshift 0 1 f_body1)) (thaw (fshift 2 2 f_body2))))))) :ruleset phase2 :unsafe-seminaive)  ; sum-sum-vert-fuse-1
(rule ((= lhs (Sum (Sum R (Sing (Unique key) body1)) body2))  (= f_body1 (best body1)) (= f_body2 (best body2)))
      ((union lhs (Sum R (Let (Unique key) (Let (thaw (fshift 0 1 f_body1)) (thaw (fshift 2 2 f_body2))))))) :ruleset phase2 :unsafe-seminaive)  ; sum-sum-vert-fuse-2
(rule ((= lhs (Sum (Range st en) (IfThen (Eq (Var 0) key) body)))  (= f_st (best st)))
      ((union lhs (Sum (Range st en) (IfThen (Eq (Var 1) (Sub key (Sub (thaw (fshift 0 2 f_st)) (Num 1)))) body)))) :ruleset phase2 :unsafe-seminaive)  ; sum-range-1
(rule ((= lhs (Sum R (Sum S (IfThen (Eq (Var 2) (Var 0)) body))))  (= f_S (best S)))
      ((union lhs (Merge R (thaw (fshift 2 -2 f_S)) (Let (Var 1) body)))) :ruleset phase2 :unsafe-seminaive)  ; sum-merge
(rule ((= lhs (Get dict key))  (= f_key (best key)))
      ((union lhs (Sum dict (IfThen (Eq (Var 1) (thaw (fshift 0 2 f_key))) (Var 0))))) :ruleset phase2 :unsafe-seminaive)  ; get-to-sum
(rule ((= lhs (Sum R (IfThen (Eq (Var 1) body2) body1))) (= fv_body2 (free body2)) (= (& fv_body2 3) 0) (= f_R (best R)) (= f_body2 (best body2)))
      ((union lhs (Let (thaw (fshift 2 -2 f_body2)) (Let (Get (thaw (fshift 0 1 f_R)) (Var 0)) body1)))) :ruleset phase2 :unsafe-seminaive)  ; sum-to-get
(rewrite (Get (Range st en) idx) (Add idx (Sub st (Num 1))) :ruleset phase2)  ; get-range
(rewrite (Sum e1 (Sing (Var 1) (Var 0))) e1 :ruleset phase2)  ; sum-sing
(rewrite (Unique e) e :ruleset phase2)  ; unique-rm

(let $root (Lambda (Lambda (Sum (Var 0) (Sum (Var 0) (Sum (Var 5) (Sum (Var 2) (Sing (Var 7) (Sing (Var 5) (Sing (Var 3) (Mul (Var 0) (Get (Var 2) (Var 1)))))))))))))

(run-schedule (saturate (run aux)))  ; the analysis of the start term
(run-schedule (saturate (run phase1) (saturate (run aux)) (run phase2) (saturate (run aux))))
