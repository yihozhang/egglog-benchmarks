; Java-style points-to, matching programs/oracle/flowlog/pointsto/default.dl.
; @printsize Assign
(relation AssignAlloc (i64 i64))
(relation PrimitiveAssign (i64 i64))
(relation Load (i64 i64 i64))
(relation Store (i64 i64 i64))
(relation VarPointsTo (i64 i64))
(relation Alias (i64 i64))
(relation Assign (i64 i64))
(input AssignAlloc "AssignAlloc.tsv")
(input PrimitiveAssign "PrimitiveAssign.tsv")
(input Load "Load.tsv")
(input Store "Store.tsv")
(rule ((PrimitiveAssign var1 var2)) ((Assign var1 var2)))
(rule ((VarPointsTo instanceVar heap) (VarPointsTo iVar heap)) ((Alias instanceVar iVar)))
(rule ((AssignAlloc var heap)) ((VarPointsTo var heap)))
(rule ((Assign var2 var1) (VarPointsTo var2 heap)) ((VarPointsTo var1 heap)))
(rule ((Store var1 instanceVar2 field) (Alias instanceVar2 instanceVar1) (Load instanceVar1 var2 field))
      ((Assign var1 var2)))
(run-schedule (saturate (run)))
(print-size Assign)
