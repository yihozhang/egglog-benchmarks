; Galen reasoning, matching programs/oracle/flowlog/galen/default.dl.
; @printsize P
; @printsize Q
(relation P (i64 i64))
(relation Q (i64 i64 i64))
(relation R (i64 i64 i64))
(relation C (i64 i64 i64))
(relation U (i64 i64 i64))
(relation S (i64 i64))
(input P "P.tsv")
(input Q "Q.tsv")
(input R "R.tsv")
(input C "C.tsv")
(input U "U.tsv")
(input S "S.tsv")
(rule ((P x y) (P y z)) ((P x z)))
(rule ((P x y) (Q y r z)) ((Q x r z)))
(rule ((P y w) (U w r z) (Q x r y)) ((P x z)))
(rule ((C y w z) (P x w) (P x y)) ((P x z)))
(rule ((Q x r z) (S r q)) ((Q x q z)))
(rule ((Q x y z) (R y u e) (Q z u o)) ((Q x e o)))
(run-schedule (saturate (run)))
(print-size P)
(print-size Q)
