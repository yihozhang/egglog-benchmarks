#!/usr/bin/env python3
"""Run one benchmark with an oatlog port.

Usage: run <build-dir> <program.egg> <fact-dir|-> <threads> <out-dir> [--relaxed]

The port binary build/oatlog/<commit>/ports/target/release/<suite>--<name> must exist
(exit 3 otherwise); oatlog is single-threaded and the only flag is --relaxed. The
binary prints relation sizes in egglog's (print-size) format and writes the run time
to a JSON report; this script adds wall time and sizes to it.
"""

import json
import re
import subprocess
import sys
import time
from pathlib import Path

UNSUPPORTED = 3
SIZE = re.compile(r"^\s*\(?\((\S+) (\d+)\)\)?\s*$", re.M)


def main() -> int:
    build_dir, program, fact_dir, threads, out_dir, *flags = sys.argv[1:]
    build_dir, program, out_dir = Path(build_dir), Path(program), Path(out_dir)
    info = json.loads((build_dir / "build.json").read_text())
    out_dir.mkdir(parents=True, exist_ok=True)
    suite = program.parent.name
    binary = build_dir / "ports/target/release" / f"{suite}--{program.stem}"
    if not binary.exists():
        print(f"no oatlog port for {suite}/{program.stem}", file=sys.stderr)
        return UNSUPPORTED
    if int(threads) != 1 or fact_dir != "-" or any(f not in info.get("flags", []) for f in flags):
        print("oatlog port supports only one thread, no fact directory and only --relaxed", file=sys.stderr)
        return UNSUPPORTED

    report_path = out_dir / "port-report.json"
    cmd = [str(binary), *flags, "--report", str(report_path)]
    (out_dir / "cmd").write_text(" ".join(cmd) + "\n")
    t0 = time.perf_counter()
    with open(out_dir / "stdout", "w") as so, open(out_dir / "stderr", "w") as se:
        rc = subprocess.call(cmd, stdout=so, stderr=se, cwd=program.parent)
    wall = time.perf_counter() - t0

    report = {"wall_s": wall, "commit": info["commit"]}
    if report_path.exists():
        report.update(json.loads(report_path.read_text()))
    stdout = (out_dir / "stdout").read_text(errors="replace")
    report["sizes"] = {name: int(n) for name, n in SIZE.findall(stdout)}
    if rc < 0:
        report["signal"] = -rc
    if rc == -9 or "memory allocation of" in (out_dir / "stderr").read_text(errors="replace"):
        report["status_hint"] = "oom"
    (out_dir / "report.json").write_text(json.dumps(report, indent=1))
    return rc


if __name__ == "__main__":
    sys.exit(main())
