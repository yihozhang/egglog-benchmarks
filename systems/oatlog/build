#!/usr/bin/env bash
# Build oatlog at a git ref together with every port under benchmarks/*/oatlog/*.egg.
# Usage: build <ref>      (prints the build directory build/oatlog/<commit>)
set -euo pipefail
ref=${1:?usage: build <ref>}
here=$(dirname "$(readlink -f "$0")")
root=$(readlink -f "$here/../..")
repo=$root/build/oatlog/repo
url=https://github.com/oatlog/oatlog

if [ ! -d "$repo/.git" ]; then
  mkdir -p "$root/build/oatlog"
  git clone -q "$url" "$repo" >&2
fi
sha=$(git -C "$repo" rev-parse --verify --quiet "$ref^{commit}" || true)
if [ -z "$sha" ]; then
  git -C "$repo" fetch -q origin "+refs/heads/*:refs/remotes/origin/*" "+refs/tags/*:refs/tags/*" >&2
  sha=$(git -C "$repo" rev-parse --verify "$ref^{commit}")
fi
out=$root/build/oatlog/${sha:0:12}
mkdir -p "$out"
if [ ! -f "$out/src/Cargo.toml" ]; then
  rm -rf "$out/src"
  git -C "$repo" worktree prune
  git -C "$repo" worktree add -q --detach "$out/src" "$sha" >&2
fi

# One cargo package with a generated main.rs per port (the egglog program is
# compiled into the binary by oatlog's proc macro; the include path is absolute).
mkdir -p "$out/ports/src"
{
  cat <<TOML
[package]
name = "oatlog-ports"
version = "0.0.0"
edition = "2024"

[dependencies]
oatlog = { path = "../src/oatlog" }

[profile.release]
debug = false
TOML
  for port in "$root"/benchmarks/*/oatlog/*.egg; do
    [ -f "$port" ] || continue
    suite=$(basename "$(dirname "$(dirname "$port")")")
    name=$(basename "$port" .egg)
    main=$out/ports/src/$suite--$name.rs
    sed "s|@PORT@|$port|g" "$here/main.rs.in" > "$main.tmp"
    cmp -s "$main.tmp" "$main" && rm "$main.tmp" || mv "$main.tmp" "$main"
    printf '\n[[bin]]\nname = "%s--%s"\npath = "src/%s--%s.rs"\n' "$suite" "$name" "$suite" "$name"
  done
} > "$out/ports/Cargo.toml"
echo "building oatlog@$ref ($sha) ports in $out/ports" >&2
# cargo does not track files read by proc macros: force a rebuild when a port changed
for port in "$root"/benchmarks/*/oatlog/*.egg; do
  [ -f "$port" ] || continue
  suite=$(basename "$(dirname "$(dirname "$port")")"); name=$(basename "$port" .egg)
  bin=$out/ports/target/release/$suite--$name
  if [ -f "$bin" ] && [ "$port" -nt "$bin" ]; then touch "$out/ports/src/$suite--$name.rs"; fi
done
(cd "$out/ports" && cargo build --release -q) >&2

python3 - "$out/build.json" "$ref" "$sha" <<'PY'
import json, sys, pathlib
path, ref, sha = sys.argv[1:]
bins = sorted(p.name for p in (pathlib.Path(path).parent / "ports/target/release").iterdir()
              if p.is_file() and "--" in p.name and not p.suffix)
json.dump({"system": "oatlog", "ref": ref, "commit": sha, "ports": bins, "threads": False,
           "flags": ["--relaxed"]}, open(path, "w"), indent=1)
PY
echo "$out"
