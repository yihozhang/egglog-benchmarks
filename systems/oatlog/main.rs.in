//! Generated by systems/oatlog/build for one port; do not edit.
//! The egglog program (including its (run N) commands) is compiled into `Theory`, and
//! `Theory::new()` executes it. We time that and print the relation sizes in egglog's
//! (print-size) format.
mod strict {
    oatlog::compile_egraph_strict!(r#"(include "@PORT@")"#);
}
mod relaxed {
    oatlog::compile_egraph_relaxed!(r#"(include "@PORT@")"#);
}

fn report(run_s: f64, sizes: std::collections::BTreeMap<&'static str, usize>, report: Option<String>) {
    println!("(");
    for (name, n) in &sizes {
        println!(" ({name} {n})");
    }
    println!(")");
    eprintln!("oatlog: {run_s:.3}s, {} relation entries", sizes.values().sum::<usize>());
    if let Some(path) = report {
        std::fs::write(path, format!("{{\"run_s\": {run_s}}}")).expect("write report");
    }
}

fn main() {
    let mut relaxed = false;
    let mut path = None;
    let mut args = std::env::args().skip(1);
    while let Some(a) = args.next() {
        match a.as_str() {
            "--relaxed" => relaxed = true,
            "--report" => path = Some(args.next().expect("--report FILE")),
            _ => panic!("unknown argument {a}"),
        }
    }
    let t0 = std::time::Instant::now();
    if relaxed {
        let t = relaxed::Theory::new();
        report(t0.elapsed().as_secs_f64(), t.get_relation_entry_count(), path);
    } else {
        let t = strict::Theory::new();
        report(t0.elapsed().as_secs_f64(), t.get_relation_entry_count(), path);
    }
}
