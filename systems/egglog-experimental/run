#!/usr/bin/env python3
"""Run one benchmark's egglog-experimental port with one egglog-experimental build.

Usage: run <build-dir> <program.egg> <fact-dir|-> <threads> <out-dir> [egglog flags...]

The port benchmarks/<suite>/egglog-experimental/<name>.egg must exist (exit 3 otherwise):
the benchmark program written for the experimental scheduling language (`let-scheduler`,
`run-with`). Everything else is exactly systems/egglog/run, which this script execs with
the port in place of the program: the build directory has the same layout (egglog -> the
egglog-experimental binary, build.json with flags/threads/stats_json), the CLI and the
REPL protocol are egglog's, and report.json has the same fields.
"""

import os
import sys
from pathlib import Path

UNSUPPORTED = 3


def main() -> int:
    build_dir, program, fact_dir, threads, out_dir, *flags = sys.argv[1:]
    program = Path(program).absolute()  # the harness runs adapters in the benchmark's directory
    port = program.parent / "egglog-experimental" / f"{program.stem}.egg"
    if not port.is_file():
        print(f"no egglog-experimental port for {program.parent.name}/{program.stem}", file=sys.stderr)
        return UNSUPPORTED
    run = Path(__file__).resolve().parent.parent / "egglog" / "run"
    os.execv(str(run), [str(run), build_dir, str(port), fact_dir, threads, out_dir, *flags])


if __name__ == "__main__":
    sys.exit(main())
