# Image for the foresight baseline. Build context: system/ (this directory) and ports/<suite>/.
FROM docker.io/library/eclipse-temurin:21-jdk-jammy
ARG REF
ARG SBT_LAUNCHER_VERSION=1.9.9

RUN apt-get update \
 && apt-get install -y --no-install-recommends git curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
# The sbt launcher; the sbt version actually used comes from each project's build.properties.
RUN curl -fsSL "https://github.com/sbt/sbt/releases/download/v${SBT_LAUNCHER_VERSION}/sbt-${SBT_LAUNCHER_VERSION}.tgz" \
    | tar -xz -C /opt
ENV PATH=/opt/sbt/bin:$PATH \
    SBT_OPTS="-Dsbt.server.forcestart=false -Dsbt.ci=true -Dsbt.color=false -Dsbt.supershell=false -Dsbt.log.noformat=true -Xmx4g"

# foresight itself: clone, check out REF, publish the core library and the examples module (the
# horner and matmul-assoc ports use foresight's own examples/poly and examples/mm languages and
# rules) to the local ivy repo as version "bench" (the ports depend on exactly that). Default
# Scala of the repo (3.x).
RUN git clone https://github.com/jonathanvdc/foresight /opt/foresight \
 && git -C /opt/foresight checkout --detach "$REF"
WORKDIR /opt/foresight
RUN sbt -batch \
      'set ThisBuild / version := "bench"' \
      'set foresight / Compile / packageDoc / publishArtifact := false' \
      'set foresight / Compile / packageSrc / publishArtifact := false' \
      'set examples / Compile / packageDoc / publishArtifact := false' \
      'set examples / Compile / packageSrc / publishArtifact := false' \
      foresight/publishLocal examples/publishLocal \
 && sbt -batch 'show foresight/scalaVersion' | grep -oE '^\[info\] [0-9]+\.[0-9]+\.[0-9]+$' | tail -n 1 | sed 's/.* //' > /opt/foresight/SCALA_VERSION \
 && test -s /opt/foresight/SCALA_VERSION && cat /opt/foresight/SCALA_VERSION

# The ports: one sbt project per suite; compile and record its runtime classpath.
COPY system/ /bench/
COPY ports/ /bench/ports/
RUN chmod +x /bench/entry.sh \
 && for d in /bench/ports/*/; do \
      ( cd "$d" \
        && FORESIGHT_SCALA="$(cat /opt/foresight/SCALA_VERSION)" \
           sbt -batch compile 'export Runtime/fullClasspath' \
           | grep -E '^[^[ ].*(classes|\.jar)' | tail -n 1 > classpath \
        && test -s classpath && grep -q foresight classpath ) || exit 1; \
    done

ENTRYPOINT ["/bench/entry.sh"]
