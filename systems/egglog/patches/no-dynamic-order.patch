+/// Whether dynamic variable ordering *during* query execution is enabled. The
+/// initial size-based ordering at the start of each execution always happens;
+/// this only controls whether the remaining stages are re-sorted as the join
+/// proceeds (see `run_plan`). Enabled by default.
+static DYNAMIC_VARIABLE_ORDERING: AtomicBool = AtomicBool::new(true);
+
+/// Globally enable or disable re-sorting of the remaining join stages during
+/// query execution. Intended for ablation experiments; takes effect for
+/// queries started after the call.
+pub fn set_dynamic_variable_ordering(enabled: bool) {
+    DYNAMIC_VARIABLE_ORDERING.store(enabled, Ordering::Relaxed);
+}
+
+pub(super) fn dynamic_variable_ordering_enabled() -> bool {
+    DYNAMIC_VARIABLE_ORDERING.load(Ordering::Relaxed)
+}
