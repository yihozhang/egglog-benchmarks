#!/usr/bin/env python3
"""Run one benchmark's egglog-storel-backoff port with one egglog-storel build.

Usage: run <build-dir> <program.egg> <fact-dir|-> <threads> <out-dir> [egglog flags...]

The port benchmarks/<suite>/egglog-storel-backoff/<name>.egg must exist (exit 3 otherwise): the
benchmark program using the extension's `F` sort and `thaw` primitive. Everything else is
exactly systems/egglog/run, which this script execs with the port in place of the program
(the build directory has egglog's layout: egglog -> the extension binary, build.json).
"""

import os
import re
import sys
from pathlib import Path

UNSUPPORTED = 3


def main() -> int:
    build_dir, program, fact_dir, threads, out_dir, *flags = sys.argv[1:]
    program = Path(program).absolute()  # the harness runs adapters in the benchmark's directory
    port = program.parent / "egglog-storel-backoff" / f"{program.stem}.egg"
    if not port.is_file():
        print(f"no egglog-storel-backoff port for {program.parent.name}/{program.stem}", file=sys.stderr)
        return UNSUPPORTED
    batch = int(os.environ.get("BENCH_STOREL_REWRITE_BATCH", "1"))
    if batch not in (1, 2, 4, 8):
        raise ValueError("BENCH_STOREL_REWRITE_BATCH must be 1, 2, 4, or 8")
    if batch > 1:
        # Keep phase order, rules, backoff state and node target fixed. Refresh aux
        # after K executions of each rewrite phase instead of after every execution.
        prefix, marker, schedule = port.read_text().partition(";; BENCHMARK_NODE_LIMIT")
        if not marker:
            raise ValueError("STOREL schedule experiment requires a node-limit marker")
        schedule, count = re.subn(r"\(run-with bo (phase[12])\)",
                                 lambda m: f"(repeat {batch} {m.group(0)})", schedule)
        if count != 2:
            raise ValueError("expected one phase1 and one phase2 in the original schedule")
        generated = Path(out_dir) / "storel-schedule.egg"
        generated.parent.mkdir(parents=True, exist_ok=True)
        generated.write_text(prefix + marker + schedule)
        port = generated
    run = Path(__file__).resolve().parent.parent / "egglog" / "run"
    os.execv(str(run), [str(run), build_dir, str(port), fact_dir, threads, out_dir, *flags])


if __name__ == "__main__":
    sys.exit(main())
